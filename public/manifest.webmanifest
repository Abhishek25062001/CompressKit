{
  "name": "CompressKit",
  "short_name": "CompressKit",
  "description": "Private file tools that run in your browser: compress, convert, resize, trim, remove backgrounds and hidden location data, and work with PDFs. No uploads.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#080a0a",
  "theme_color": "#0a8069",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
